generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Test {
  id    String @id @default(auto()) @map("_id") @db.ObjectId
  name  String
  value Int
}

model DailyMenu {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  date      DateTime
  messId    String   @db.ObjectId
  monthId   String   @db.ObjectId
  dayNameEn String? // e.g., "Thursday"
  dayNameBn String? // e.g., "বৃহস্পতিবার"

  breakfast String[] // List of breakfast items, e.g., ["Paratha", "Egg Omelette", "Tea"]
  lunch     String[] // List of lunch items, e.g., ["Rice", "Chicken Curry", "Dal", "Vegetable Mix"]
  dinner    String[] // List of dinner items, e.g., ["Rice", "Fish Fry", "Dal", "Spinach"]

  notes     String? // Optional special notes for the day's menu, e.g., "Special biryani for Thursday lunch"
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  deletedAt DateTime?  @map("deleted_at")
  mess      Mess?      @relation(fields: [messId], references: [id])
  month     MessMonth? @relation(fields: [monthId], references: [id])
}

enum FeedbackType {
  GENERAL
  SUGGESTION
  BUG
  COMPLAINT
  FEEDBACK
  FEATURE_REQUEST
  OTHER
}

model Feedback {
  id          String       @id @default(auto()) @map("_id") @db.ObjectId
  userId      String?      @db.ObjectId
  messId      String?      @db.ObjectId
  isAnonymous Boolean
  subject     String
  message     String
  type        FeedbackType
  status      String       @default("Pending")
  adminNotes  String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?    @map("deleted_at")
  user        User?        @relation(fields: [userId], references: [id])

  @@index([userId, isAnonymous])
}

model User {
  id                  String     @id @default(auto()) @map("_id") @db.ObjectId
  name                String
  email               String     @unique
  password            String
  phone               String
  bio                 String?
  emergencyContact    String?
  dateOfBirth         DateTime?
  bloodGroup          String?
  nidNumber           String?
  profession          String?
  address             String?
  activeStatus        Boolean    @default(true)
  joinDate            DateTime   @default(now())
  role                String     @default("member")
  emailVerifiedAt     DateTime?
  verificationToken   String?
  verificationExpires DateTime?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  Feedback            Feedback[]

  MessMember MessMember[]
  MessMonth  MessMonth[]
  notices    NoticeBoard[]

  Notification Notification[]
}

// ------------------------------------------------------
// Meal Management Models
// ------------------------------------------------------

enum Status {
  ABSENT
  FULL
  PARTIAL
}

model MealEntry {
  id              String     @id @default(auto()) @map("_id") @db.ObjectId
  memberId        String     @db.ObjectId
  messId          String     @db.ObjectId
  date            DateTime
  breakfastStatus Int        @default(1)
  lunchStatus     Int        @default(1)
  dinnerStatus    Int        @default(1)
  guestCount      Int        @default(0)
  status          Status     @default(FULL)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  deletedAt       DateTime?  @map("deleted_at")
  member          MessMember @relation(fields: [memberId], references: [id])
  mess            Mess       @relation(fields: [messId], references: [id])
}

// ------------------------------------------------------
// Mess Management Models
// ------------------------------------------------------

model Mess {
  id          String       @id @default(auto()) @map("_id") @db.ObjectId
  name        String       @unique
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  members     MessMember[]
  months      MessMonth[]

  DailyMenu DailyMenu[]

  MealEntry MealEntry[]

  Event Event[]
}

enum MessRole {
  ADMIN
  SUB_ADMIN
  MEMBER
}

model MessMember {
  id        String      @id @default(auto()) @map("_id") @db.ObjectId
  messId    String      @db.ObjectId
  userId    String      @unique @db.ObjectId
  role      MessRole    @default(MEMBER)
  joinedAt  DateTime    @default(now())
  leftAt    DateTime?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  mess      Mess        @relation(fields: [messId], references: [id])
  user      User        @relation(fields: [userId], references: [id])
  MealEntry MealEntry[]

  @@unique([messId, userId])
}

model MessMonth {
  id            String      @id @default(auto()) @map("_id") @db.ObjectId
  messId        String      @db.ObjectId
  month         DateTime    @unique @db.Date
  banglaMonth   String?
  englishMonth  String?
  mealManagerId String      @db.ObjectId
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  mess          Mess        @relation(fields: [messId], references: [id])
  mealManager   User        @relation(fields: [mealManagerId], references: [id])
  DailyMenu     DailyMenu[]

  @@unique([messId, month])
}

// ------------------------------------------------------
// Event Model
// ------------------------------------------------------
enum EventType {
  MESS
  MEAL
  BAZAR
  REPORT
  FEEDBACK
}

enum EventStatus {
  UPCOMING
  ONGOING
  COMPLETED
  CANCELED
  PAST
}

model Event {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  messId      String   @db.ObjectId
  title       String
  description String?
  date        DateTime @db.Date
  time        String
  location    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  mess        Mess     @relation(fields: [messId], references: [id])
  status      EventStatus @default(UPCOMING)
  type        EventType @default(MESS)

  Notification Notification[]
}

// ------------------------------------------------------
// Notification Model
// ------------------------------------------------------

// combined with event and notice board
enum NotificationType {
  MESS
  MEAL
  BAZAR
  REPORT
  FEEDBACK
  EVENT
  OTHER
}

model Notification {
  id        String           @id @default(auto()) @map("_id") @db.ObjectId
  userId    String           @db.ObjectId
  eventId   String?          @db.ObjectId
  type      NotificationType
  title     String
  message   String
  read      Boolean          @default(false)
  link      String?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id])
  event     Event?           @relation(fields: [eventId], references: [id])
}

// ------------------------------------------------------
// Notice Board Model
// ------------------------------------------------------

model NoticeBoard {
  id           String     @id @default(auto()) @map("_id") @db.ObjectId
  title        String
  description  String
  creator_role String
  creator_id   String     @db.ObjectId
  created_at   DateTime   @default(now())
  updated_at   DateTime   @updatedAt
  expiry_date  DateTime?
  label        String?
  type         NoticeType
  deletedAt    DateTime?  @map("deleted_at")

  // Relations
  creator User @relation(fields: [creator_id], references: [id])
}

enum NoticeType {
  URGENT
  GENERAL
  EVENT
  PAYMENT_REMINDER
  RULE_UPDATE
}
